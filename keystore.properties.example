# GAMA release signing — copy this file to "keystore.properties" at the repo
# root and fill in your real values. keystore.properties is gitignored.
#
# CI alternative: set the equivalent environment variables instead:
#   GAMA_STORE_FILE, GAMA_STORE_PASSWORD, GAMA_KEY_ALIAS, GAMA_KEY_PASSWORD
#
# storeFile may be an absolute path or relative to the app/ module directory.
storeFile=C:\\path\\to\\your-release-key.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password

# SECURITY NOTE: the previous release password was committed to this repo's
# history. If that keystore is still used for releases, rotate the password
# (keytool -storepasswd) or migrate to a new key.
